# EXEMPLO DE VARIÁVEIS — SEM CREDENCIAIS REAIS
NODE_ENV=development
APP_URL=http://localhost:3000
TZ=America/Manaus
# DATABASE_URL deve existir SOMENTE no .env privado/secret store
DATABASE_URL=postgresql://USER:CHANGE_ME@db:5432/k3gfinance
# AUTH_SECRET deve ser gerado com entropia criptográfica forte no host
AUTH_SECRET=GENERATE_LOCALLY_DO_NOT_COMMIT
DEMO_MODE=true
BILLING_LIVE_ENABLED=false
EMAIL_EXTERNAL_ENABLED=false
CORA_LIVE_ENABLED=false
FISCAL_LIVE_ENABLED=false
# Email e integrações reais somente em secrets fora do Git.
