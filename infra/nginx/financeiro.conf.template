# MODELO para NGINX no host. NÃO aplicar sem ajustar PORT/SSL_CERT/SSL_KEY e testar nginx -t.
# Só ativar login público com certificado HTTPS válido.
server {
    listen 80;
    server_name financeiro.devops.k3gsolutions.com.br;
    # Após configurar ACME/TLS válido, redirecionar:
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name financeiro.devops.k3gsolutions.com.br;
    ssl_certificate     /CAMINHO/VALIDADO/DO/CERTIFICADO/fullchain.pem;
    ssl_certificate_key /CAMINHO/VALIDADO/DA/CHAVE/privkey.pem;
    # Certificados/ciphers/protocolos conforme padrão já adotado com segurança no host.
    client_max_body_size 10m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    # HSTS/CSP somente após testar impacto nas demais funcionalidades.

    location / {
        proxy_pass http://127.0.0.1:PORTA_LOOPBACK_A_VALIDAR;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
